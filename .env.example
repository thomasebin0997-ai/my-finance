# Copy to .env for local development. On Render, set these in the dashboard
# (render.yaml creates most of them for you).

# PostgreSQL connection string
#   Local (Postgres.app / Homebrew): postgres://localhost:5432/kanakku
#   Neon (free, hosted):             postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://localhost:5432/kanakku
# Set to true to force TLS (automatic for any non-local host)
DATABASE_SSL=false

# Sign-in password for the app
APP_PASSWORD=choose-a-long-password
# Random string used to sign the login cookie (openssl rand -base64 32)
SESSION_SECRET=replace-with-a-random-string

# Key the daily scheduler sends to /api/cron/reminders
CRON_SECRET=replace-with-another-random-string
# Time zone used to decide what "today" is for reminders
APP_TIMEZONE=Asia/Kolkata
# Public URL, used for the link inside reminder messages (Render sets RENDER_EXTERNAL_URL automatically)
APP_URL=

# Reminders via Telegram (free): create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reminders via email (Resend)
RESEND_API_KEY=
REMINDER_EMAIL_FROM=Kanakku <reminders@yourdomain.com>
REMINDER_EMAIL_TO=you@example.com

PORT=3000
