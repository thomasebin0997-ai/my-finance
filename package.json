{
  "name": "kanakku",
  "version": "1.0.0",
  "private": true,
  "description": "Personal money ledger: income, expenses, bank and category reports, EMIs and chitty with reminders.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "migrate": "tsx server/cli.ts migrate",
    "remind": "tsx server/cli.ts remind",
    "seed:examples": "tsx server/cli.ts seed",
    "import": "tsx server/cli.ts import",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
